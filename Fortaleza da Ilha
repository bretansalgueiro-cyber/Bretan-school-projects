Style.CSs

:root {
    --cor-primaria: #183C63;
    --cor-fundo: #ffffff;
    --cor-botao: #f9f9f9;
    --cor-texto: #ffffff;
    --cor-pão: #b37474;
    --cor-ilha: #C2B280;
    .tema-escuro {
    --cor-primaria: #c9e3ff;
    --cor-fundo: #151428;
    --cor-texto: #030303;
    --cor-constraste: #000000;    
    --cor-texto-2: #ffffff;
} 
    .tema-escuro a {
     color: var(--cor-pão)
}
    --fonte-texto: 'Times new Roman', sans-serif;
}


header {
    background-color: var(--cor-pão);

}
header {
    background-color: var(--cor-ilha);
    color: var(--cor-texto);
    text-align: center;
    margin: 0 auto;
    padding: 16px;

}


main {
    background-color:var(--cor-fundo);
    color: var(--cor-texto-2);
    margin: 0 auto;
    padding: 16px;
    display: flex;
    flex-wrap: wrap;

}

article {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
    
    box-shadow: 0 2px 6px rgba(1, 1, 1, 1.6);
    margin: 16px;
    gap: 16px;
    padding: 16px;
    flex: 1 1 25%;
}
img {
    width: 700px;
    height: 700px;
}

.artigo-autor {
    font-weight: bold;
}

body {
    max-width: 100vw;
    font-family: var(--fonte-texto);
}

.btn-tema-escuro {
    position: fixed;
    bottom: 16px; 
    right: 16px; 
    font-size: 32px;
    padding: 12px; 
    background-color: var(--cor-primaria); 
    border-radius: 50%; 
    border: none; 
    cursor: pointer;
}

 * {
    transition: background-color 1s ease;
}

h2 {
  font-size: 30px;
}

p {
  font-size: 24px;
}


